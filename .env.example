# ===================================================================
# إعدادات مفاتيح الاتصال - Quran Reels Generator
# قم بنسخ هذا الملف وتسميته .env ثم ضع مفاتيحك الخاصة
# ===================================================================

# 1. مفتاح موقع Pexels لجلب خلفيات الطبيعة مجاناً بجودة عالية
# يمكنك الحصول عليه مجاناً عبر التسجيل في: https://www.pexels.com/api/
# (إذا تركته فارغاً سيتم توليد خلفيات ألوان وتدرجات طبيعية تلقائياً)
PEXELS_API_KEY=هنا_ضع_مفتاح_pexels_api_الخاص_بك

# 2. بيانات واجهة يوتيوب (YouTube Data API v3)
# يتم الحصول على هذه البيانات تلقائياً بعد تشغيل سكربت: python setup_youtube.py
YOUTUBE_CLIENT_ID=هنا_ضع_معرف_العميل_client_id
YOUTUBE_CLIENT_SECRET=هنا_ضع_الرمز_السري_client_secret
YOUTUBE_REFRESH_TOKEN=هنا_ضع_رمز_التحديث_refresh_token
